# AegisTrader Environment Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# TRADING MODE CONFIGURATION
# =============================================================================
# WARNING: Set to 'true' only when you want to trade with real money!
LIVE_TRADING=false

# =============================================================================
# BROKER API CREDENTIALS
# =============================================================================
# Only required for live trading
BROKER_NAME=mock
BROKER_API_KEY=your_api_key_here
BROKER_API_SECRET=your_api_secret_here
BROKER_SANDBOX=true

# =============================================================================
# INSTITUTIONAL / PROP-DESK CONTROLS
# =============================================================================
# Emergency stop: when true, no new orders are submitted (scanner may still run)
KILL_SWITCH=false

# Rolling 60s cap on outbound order attempts
MAX_ORDERS_PER_MINUTE=30

# Broker place_order retries for transient errors (timeouts, rate limits)
BROKER_MAX_RETRIES=3
BROKER_RETRY_BACKOFF_BASE_SEC=0.5

# Circuit breaker: halt new orders after this many failures within the window
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SEC=60

# Append-only JSONL audit log (orders/risk events; secrets redacted)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=logs/audit.jsonl

# Periodic OMS reconciliation with venue (0 = disabled). Use in live/paper with a real broker.
RECONCILE_EVERY_N_LOOPS=0

# =============================================================================
# OMS (SQLite) + SYMBOL MAP
# =============================================================================
# Persist orders to SQLite (survives restarts). Set false for in-memory only.
OMS_USE_SQLITE=true
OMS_DB_PATH=data/oms.db

# JSON map TradingView tickers → venue symbols (default: broker/symbol_map.default.json)
SYMBOL_MAP_PATH=broker/symbol_map.default.json

# =============================================================================
# BINANCE SPOT TESTNET (integration tests & live testnet trading)
# =============================================================================
# Keys from https://testnet.binance.vision/ — use with BROKER_NAME=binance BROKER_SANDBOX=true
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=
# Optional: pytest places a micro order when BINANCE_INTEGRATION_PLACE_ORDER=1

# =============================================================================
# RISK MANAGEMENT SETTINGS
# =============================================================================
# Maximum position size as percentage of account balance (0.1 = 10%)
MAX_POSITION_SIZE=0.1

# Maximum daily loss as percentage of account balance (0.05 = 5%)
MAX_DAILY_LOSS=0.05

# Stop loss percentage (0.02 = 2%)
STOP_LOSS_PERCENTAGE=0.02

# Take profit percentage (0.04 = 4%)
TAKE_PROFIT_PERCENTAGE=0.04

# =============================================================================
# MARKET CONFIGURATION
# =============================================================================
# Markets to trade (comma-separated): crypto,stocks,commodities,forex
DEFAULT_MARKETS=crypto,stocks,commodities

# Scan interval in seconds
SCAN_INTERVAL=60

# =============================================================================
# BROWSER AUTOMATION
# =============================================================================
# Browser type: chrome, firefox, edge
BROWSER_TYPE=chrome

# Run browser in headless mode (true/false)
HEADLESS_BROWSER=false

# Browser timeout in seconds
BROWSER_TIMEOUT=30

# =============================================================================
# CHART DATA (API / venue first recommended for crypto)
# =============================================================================
# vision = OCR only | binance = Binance public klines (+ OCR fallback)
# hybrid = merge API + OCR (API wins on OHLCV)
# api_first = same merge as hybrid; default; fetch REST/MCP before browser when CHART_FETCH_API_BEFORE_BROWSER=true
# mcp = use MCP market-data servers only (TradingView MCP, crypto MCPs, etc.)
CHART_DATA_SOURCE=api_first
CHART_DATA_SKIP_OCR_WHEN_API=true
CHART_FETCH_API_BEFORE_BROWSER=true
# YOLO on screenshot for patterns; set false with SCAN_SKIP_BROWSER_WHEN_API_ONLY for pure API path
SCAN_USE_YOLO=true
SCAN_SKIP_BROWSER_WHEN_API_ONLY=false
# Live: https://api.binance.com — testnet market data: https://testnet.binance.vision
BINANCE_PUBLIC_BASE_URL=https://api.binance.com

# Provider order for API prices (comma-separated): binance, mcp
# Example with TradingView/crypto MCP first, Binance REST fallback:
# MARKET_DATA_PROVIDERS=mcp,binance
MARKET_DATA_PROVIDERS=binance

# =============================================================================
# MCP PLATFORM SERVERS (TradingView MCP, crypto MCPs, …)
# =============================================================================
# Enable the multi-server MCP client bridge (requires: pip install "mcp>=1.28,<3")
MCP_ENABLED=false
# JSON registry of servers (command/url, roles, tool name maps) — see mcp_bridge/servers.default.json
MCP_SERVERS_PATH=mcp_bridge/servers.default.json
# Preferred registry keys for market data / brokerage roles
MCP_MARKET_DATA_SERVER=tradingview
MCP_BROKER_SERVER=crypto
# To trade through an MCP broker: BROKER_NAME=mcp + enable that server in the JSON registry

# =============================================================================
# VISION SYSTEM CONFIGURATION
# =============================================================================
# Path to custom YOLO model (optional)
YOLO_MODEL_PATH=models/custom_chart_patterns.pt

# OCR engine: tesseract, easyocr, paddleocr
OCR_ENGINE=tesseract

# OCR confidence threshold (0.0 to 1.0); also aliased as OCR_MIN_CONFIDENCE
OCR_CONFIDENCE_THRESHOLD=0.7
OCR_MIN_CONFIDENCE=0.35

# Upscale factor for small fonts / compressed screenshots (>=1.0)
OCR_UPSCALE_FACTOR=1.5

# Preprocess: standard | dark_ui | aggressive | preserve_color (best with easyocr/paddle)
OCR_PREPROCESS_MODE=standard

# auto | dark | light — biases adaptive threshold for dark TradingView themes
OCR_THEME=auto

# Full-panel OCR (letters + numbers); set false for digits-only legacy behavior
OCR_FULL_PANEL=true

# Run standard + dark_ui passes and merge (slower, more robust)
OCR_MULTI_PASS=false

# Structured UI reading (regions + label anchors); set false for legacy OCR only
OCR_SEMANTIC_ENABLED=true

# JSON: normalized 0-1 regions for your layout (see vision/tradingview_ui_layout.default.json)
TRADINGVIEW_UI_LAYOUT_PATH=vision/tradingview_ui_layout.default.json

# =============================================================================
# STRATEGY CONFIGURATION
# =============================================================================
# Enabled strategies (comma-separated): momentum,mean_reversion,breakout,pattern_recognition,multi_timeframe
ENABLED_STRATEGIES=momentum,breakout,pattern_recognition

# Minimum signal confidence (0.0 to 1.0)
MIN_SIGNAL_CONFIDENCE=0.7

# Risk per trade as percentage of balance (0.02 = 2%)
RISK_PER_TRADE=0.02
# Stricter sizing: add round-trip fee + spread + slippage (bps) to per-unit risk (100 bps = 1%)
RISK_APPLY_FRICTION=true
RISK_FEE_ROUND_TRIP_BPS=20
RISK_SPREAD_BPS=10
RISK_SLIPPAGE_BPS=10

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/aegistrader.log

# Maximum log file size in bytes (10MB)
LOG_MAX_SIZE=10485760

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# =============================================================================
# TEXT-TO-SPEECH CONFIGURATION
# =============================================================================
# Enable TTS feedback (true/false)
TTS_ENABLED=true

# TTS voice rate (words per minute)
TTS_VOICE_RATE=200

# =============================================================================
# DIRECTORIES
# =============================================================================
# Data directory for storing trading data
DATA_DIR=data

# Logs directory
LOGS_DIR=logs

# Models directory for AI models
MODELS_DIR=models

# Screenshots directory
SCREENSHOTS_DIR=screenshots

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
# Maximum number of concurrent browser instances
MAX_BROWSER_INSTANCES=3

# Screenshot quality (1-100)
SCREENSHOT_QUALITY=85

# Chart analysis timeout in seconds
CHART_ANALYSIS_TIMEOUT=30

# Position update interval in seconds
POSITION_UPDATE_INTERVAL=10

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Enable debug mode (additional logging and features)
DEBUG_MODE=false

# Save screenshots for debugging
SAVE_DEBUG_SCREENSHOTS=false

# Simulation mode settings
SIMULATION_INITIAL_BALANCE=10000.0
SIMULATION_TRADING_FEES=0.001
